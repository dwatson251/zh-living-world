+// Living World: the stock palette has 8 colours; larger worlds need more. Integer-only (deterministic) hue spread.
+void MultiplayerSettings::extendColors(Int target)
+{
+	for (Int n = getNumColors(); n < target; ++n)
+	{
+		MultiplayerColorDefinition *c = newMultiplayerColorDefinition("");
+		// golden-angle hue stepping gives well separated hues for any count
+		Int hue = (n * 137) % 360, sector = hue / 60, f = (hue % 60) * 255 / 60;
+		Int v = 255, p = 0, q = 255 - f, t2 = f, r, g, b;
+		switch (sector) { case 0: r=v; g=t2; b=p; break; case 1: r=q; g=v; b=p; break; case 2: r=p; g=v; b=t2; break;
