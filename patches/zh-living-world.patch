+		SupplyWarehouseDockUpdate *w = (SupplyWarehouseDockUpdate *)o->findUpdateModule( warehouseModuleKey );
+		if (w) { ++docks; before += w->getBoxesStored(); w->addCash(cash); after += w->getBoxesStored(); }
+	}
+	if (getenv("UM_TRACE_CMD")) printf("[um] supply refill: %d docks, boxes %d -> %d\n", docks, before, after);
+}
