-#else
-	#error "this is the wrong size"
-#endif
+class PlayerMaskType
+{
+public:
+	enum { WORDS = (MAX_PLAYER_COUNT + 31) / 32 };
+	UnsignedInt w[WORDS];
+
+	PlayerMaskType() { for (int i = 0; i < WORDS; ++i) w[i] = 0; }
+	PlayerMaskType(Int legacy) { w[0] = (UnsignedInt)legacy; for (int i = 1; i < WORDS; ++i) w[i] = 0; }   // only meant for 0
+
+	static PlayerMaskType bit(Int index) { PlayerMaskType m; if (index >= 0 && index < MAX_PLAYER_COUNT) m.w[index >> 5] = 1u << (index & 31); return m; }
+	static PlayerMaskType all() { PlayerMaskType m; for (int i = 0; i < MAX_PLAYER_COUNT; ++i) m.w[i >> 5] |= 1u << (i & 31); return m; }
+
+	Bool any() const { for (int i = 0; i < WORDS; ++i) if (w[i]) return true; return false; }
+	Bool testBit(Int index) const { return index >= 0 && index < MAX_PLAYER_COUNT && (w[index >> 5] >> (index & 31)) & 1u; }
+
+	PlayerMaskType &operator|=(const PlayerMaskType &o) { for (int i = 0; i < WORDS; ++i) w[i] |= o.w[i]; return *this; }
+	PlayerMaskType &operator&=(const PlayerMaskType &o) { for (int i = 0; i < WORDS; ++i) w[i] &= o.w[i]; return *this; }
+	PlayerMaskType &operator^=(const PlayerMaskType &o) { for (int i = 0; i < WORDS; ++i) w[i] ^= o.w[i]; return *this; }
+	PlayerMaskType operator|(const PlayerMaskType &o) const { PlayerMaskType r(*this); r |= o; return r; }
+	PlayerMaskType operator&(const PlayerMaskType &o) const { PlayerMaskType r(*this); r &= o; return r; }
+	PlayerMaskType operator^(const PlayerMaskType &o) const { PlayerMaskType r(*this); r ^= o; return r; }
+	PlayerMaskType operator~() const { PlayerMaskType r; for (int i = 0; i < WORDS; ++i) r.w[i] = ~w[i]; return r; }
+	Bool operator==(const PlayerMaskType &o) const { for (int i = 0; i < WORDS; ++i) if (w[i] != o.w[i]) return false; return true; }
+	Bool operator!=(const PlayerMaskType &o) const { return !(*this == o); }
+	Bool operator==(Int legacy) const { return *this == PlayerMaskType(legacy); }
+	Bool operator!=(Int legacy) const { return !(*this == PlayerMaskType(legacy)); }
+	Bool operator!() const { return !any(); }
+	// safe-bool: lets `while (mask)` / `if (mask)` keep working without enabling arithmetic conversions
+	struct SafeBoolHelper { int x; };
+	typedef int SafeBoolHelper::*SafeBool;
+	operator SafeBool() const { return any() ? &SafeBoolHelper::x : 0; }
+};
+
+static const PlayerMaskType PLAYERMASK_ALL = PlayerMaskType::all();
+static const PlayerMaskType PLAYERMASK_NONE = PlayerMaskType();
 
