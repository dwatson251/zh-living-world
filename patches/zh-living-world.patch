+// Unpaid rent hurts in order: first every attack-capable unit the player has; once none is left, the buildings (except command centers);
+// then dozers/workers and any other non-attacking units; the command center goes last. permille is the share of maximum health taken per call.
+void UmRentDamage(Int slotNum, Int permille)
+{
+	Player *player = umPlayerForSlot(slotNum); if (!player || permille <= 0) return;
+	std::vector<Object *> tier[4];
+	for (Object *o = TheGameLogic->getFirstObject(); o; o = o->getNextObject())
+	{
+		if (o->getControllingPlayer() != player || o->isEffectivelyDead()) continue;
+		Bool structure = o->isKindOf(KINDOF_STRUCTURE), dozer = o->isKindOf(KINDOF_DOZER);
+		Int t;
+		if (structure) t = o->isKindOf(KINDOF_COMMANDCENTER) ? 3 : 1;
+		else if (dozer) t = 2;
+		else t = o->isAbleToAttack() ? 0 : 2;
+		tier[t].push_back(o);
+	}
+	for (Int t = 0; t < 4; ++t)
+	{
+		if (tier[t].empty()) continue;
+		if (getenv("UM_TRACE_CMD")) printf("[um] rent damage on slot %d: tier %d (%d objects), %d permille\n", (int)slotNum, (int)t, (int)tier[t].size(), (int)permille);
+		for (size_t i = 0; i < tier[t].size(); ++i)
+		{
+			BodyModuleInterface *body = tier[t][i]->getBodyModule(); if (!body) continue;
+			DamageInfo di; di.in.m_damageType = DAMAGE_UNRESISTABLE; di.in.m_deathType = DEATH_NORMAL; di.in.m_sourceID = INVALID_ID;
+			di.in.m_amount = body->getMaxHealth() * (Real)permille / 1000.0f;
+			tier[t][i]->attemptDamage(&di);
+		}
+		break;   // only the first tier that still has something takes damage
+	}
+}
