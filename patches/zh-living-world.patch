+void SupplyWarehouseDockUpdate::addCash( Int cash )
+{
+	Int most = getSupplyWarehouseDockUpdateModuleData()->m_startingBoxesData;
+	Int add = (Int)ceil(cash / (float)TheGlobalData->m_baseValuePerSupplyBox);
+	if (add <= 0 || m_boxesStored >= most) return;
+	m_boxesStored += add; if (m_boxesStored > most) m_boxesStored = most;
+	Drawable *draw = getObject()->getDrawable();
+	if( draw )
+		draw->updateDrawableSupplyStatus( most, m_boxesStored );
+}
