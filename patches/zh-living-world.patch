+
+void Player::umResetScripts()
+{
+	if (m_playerType != PLAYER_COMPUTER) return;
+	ScriptList *cur = TheSidesList->getSideInfo(getPlayerIndex())->getScriptList();
+	if (!cur) return;
+	AsciiString mySide = getSide();
+	for (Int n = 0; n < TheSidesList->getNumSkirmishSides(); n++)
+	{
+		SidesInfo *sk = TheSidesList->getSkirmishSideInfo(n);
+		const PlayerTemplate *spt = ThePlayerTemplateStore->findPlayerTemplate(NAMEKEY(sk->getDict()->getAsciiString(TheKey_playerFaction)));
+		if (!spt || spt->getSide() != mySide || !sk->getScriptList()) continue;
+		AsciiString qualifier; qualifier.format("%d", m_mpStartIndex);
+		AsciiString qualName; qualName.format("%s%d", sk->getDict()->getAsciiString(TheKey_playerName).str(), m_mpStartIndex);
+		AsciiString pname = TheSidesList->getSideInfo(getPlayerIndex())->getDict()->getAsciiString(TheKey_playerName);
+		ScriptList *fresh = sk->getScriptList()->duplicateAndQualify(qualifier, qualName, pname);
+		umCopyScriptState(cur->getScript(), fresh->getScript());
+		ScriptGroup *dg = cur->getScriptGroup(), *sg = fresh->getScriptGroup();
+		for (; dg && sg; dg = dg->getNext(), sg = sg->getNext())
+		{
+			dg->setActive(sg->isActive());
+			umCopyScriptState(dg->getScript(), sg->getScript());
+		}
+		fresh->deleteInstance();
+		return;
+	}
+}
